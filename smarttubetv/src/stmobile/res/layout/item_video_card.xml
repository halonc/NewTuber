<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-grid video card, YouTube-style: a flat (no box, no elevation) cell whose thumbnail is
  clipped to rounded corners by the inner MaterialCardView, with title/channel text sitting
  directly on the window background. The outer card is only the click/ripple container.

  NEWTUBE(card-density): the text block is laid out the way YouTube lays it out, so the title
  gets the whole card width:
    - the title spans the full width (it used to start 52dp in, behind the channel avatar) and is
      capped at two lines; its size lives in @dimen/mobile_card_title_text_size
    - the avatar moved down into the middle line, left of "Channel · 1.2M views · 3 weeks ago",
      which is where YouTube puts it on a phone
  VideoCardAdapter also applies a "compact" variant (tighter margins, smaller avatar and middle
  line, narrower ⋮) when the user turns that on in Settings.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/mobile_card_spacing"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- MaterialCardView (a FrameLayout) clips the thumbnail + badge + progress to rounded
             corners; the watched-progress bar stays inside the rounded shape like YouTube. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_thumbnail_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/mobile_color_placeholder"
            app:cardCornerRadius="@dimen/mobile_card_corner_radius"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/video_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_video_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="12:34" />

            <ProgressBar
                android:id="@+id/video_watch_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:progressBackgroundTint="@color/mobile_color_progress_track"
                android:progressTint="@color/mobile_color_progress"
                android:visibility="gone"
                tools:progress="40"
                tools:visibility="visible" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Full-width title: starts at the card edge (4dp in), ends before the ⋮ column. -->
        <TextView
            android:id="@+id/video_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/mobile_card_title_top_margin"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2sp"
            android:maxLines="2"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="@dimen/mobile_card_title_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_thumbnail_frame"
            tools:text="A great video title that may wrap to two lines" />

        <!-- Overflow = same context menu as card long-press (VideoMenuPresenter: Not interested,
             Open channel, playlists, ...). NEWTUBE(card-density): on the middle line's right edge,
             where YouTube's own app puts it - on the title row it reserved a 40-48dp column of
             every card and pushed the title short. -->
        <ImageButton
            android:id="@+id/video_overflow"
            android:layout_width="@dimen/mobile_card_overflow_size"
            android:layout_height="@dimen/mobile_card_overflow_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_player_more"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_more_vert"
            app:layout_constraintBottom_toBottomOf="@id/video_meta_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/video_meta_row" />

        <!-- NEWTUBE(card-density): avatar + one quiet meta line, YouTube's order
             ("Channel · 1.2M views · 3 weeks ago"). A row so the avatar and the text share one
             vertical centre; the adapter hides the avatar on screens that have no channel. -->
        <LinearLayout
            android:id="@+id/video_meta_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="@dimen/mobile_card_meta_bottom_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/video_overflow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_title">

            <ImageView
                android:id="@+id/video_channel_avatar"
                android:layout_width="@dimen/mobile_card_avatar_size"
                android:layout_height="@dimen/mobile_card_avatar_size"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_card_avatar_placeholder"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/video_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mobile_card_meta_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="@dimen/mobile_card_meta_text_size"
                tools:text="Channel name · 1.2M views · 3 weeks ago" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
